# Environment Variables Template
# Copy this file to .env and update the values

# Django Settings
SECRET_KEY=your-secret-key-here-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
DB_ENGINE=django.db.backends.postgresql
DB_NAME=surveillance_db
DB_USER=surveillance_user
DB_PASSWORD=your_database_password
DB_HOST=localhost
DB_PORT=5432

# For MySQL instead:
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=surveillance_db
# DB_USER=surveillance_user
# DB_PASSWORD=your_database_password
# DB_HOST=localhost
# DB_PORT=3306

# Media and Static Files
MEDIA_ROOT=/path/to/media
STATIC_ROOT=/path/to/static

# CORS Settings (Frontend URLs)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Email Settings (for notifications)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Redis (for Celery - optional)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Model Paths (relative to MEDIA_ROOT/models/)
MOTION_MODEL_PATH=yolo11n.pt
SHOPLIFTING_MODEL_PATH=shoplifting_wights.pt
BALACLAVA_MODEL_PATH=skimask.pt
WEAPON_MODEL_PATH=best-custom.pt

# Processing Settings
DEFAULT_TARGET_FPS=10
DEFAULT_MOTION_CONFIDENCE=0.6
DEFAULT_PERSIST_FRAMES=5

# Alert Settings
ALERT_RETENTION_DAYS=90
MAX_ALERTS_PER_CAMERA_PER_DAY=100

# API Settings
API_RATE_LIMIT=100/hour
API_PAGE_SIZE=20
